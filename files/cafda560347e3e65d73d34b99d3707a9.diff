@@ -0,0 +1,70 @@
+using Escape.Companions;
+using Escape.Stage;
+using Escape.Visuals;
+using UnityEngine;
+
+namespace Escape.UI
+{
+    // Cosmetic title preview only. Never equips a chip or writes profile/save data.
+    [DefaultExecutionOrder(100)]
+    public sealed class TitleRosterPresentation : MonoBehaviour
+    {
+        FrontEndController front;
+        SessionTestWorld world;
+        SdCharacterVisual visual;
+        object originalSession;
+        string originalId;
+        bool previewing;
+        int index=-1,pendingDirection;
+        readonly System.Random random=new System.Random();
+        public static Rect ControlsRect=>FigmaInventoryLayout.Rect(1120,976,460,40);
+        public string DisplayedCharacterId=>previewing && visual!=null?visual.CurrentCompanionId:null;
+        public void Initialize(FrontEndController controller,SessionTestWorld owner){front=controller;world=owner;}
+        void LateUpdate()
+        {
+            bool visible=front!=null && front.isActiveAndEnabled && front.Page==FrontPage.Title && world!=null && !world.StoryPlaying;
+            if(!visible){Restore();return;}
+            if(previewing){if(pendingDirection!=0){int direction=pendingDirection;pendingDirection=0;Step(direction);}return;}
+            visual=world.Inventory.Player.GetComponent<SdCharacterVisual>();
+            if(visual==null)return;
+            originalId=visual.CurrentCompanionId;originalSession=world.Session;
+            previewing=true;
+            int count=CompanionChipCatalog.All.Count;
+            if(count>0)ShowFrom(random.Next(count),1);
+        }
+        public bool Step(int direction)
+        {
+            if(!previewing || front.Page!=FrontPage.Title)return false;
+            return ShowFrom(index+(direction<0?-1:1),direction<0?-1:1);
+        }
+        bool ShowFrom(int start,int direction)
+        {
+            var roster=CompanionChipCatalog.All;
+            for(int n=0;n<roster.Count;n++)
+            {
+                int candidate=((start+n*direction)%roster.Count+roster.Count)%roster.Count;
+                var entry=roster[candidate];
+                if(string.IsNullOrEmpty(entry.ModelResourcePath) || Resources.Load<GameObject>(entry.ModelResourcePath)==null)continue;
+                if(visual.ApplyCompanion(entry.Id)){index=candidate;return true;}
+            }
+            return false;
+        }
+        void Restore()
+        {
+            if(!previewing)return;
+            previewing=false;index=-1;pendingDirection=0;
+            // A newly loaded profile already owns the actor's appearance; do not overwrite it.
+            if(visual!=null && world!=null && ReferenceEquals(originalSession,world.Session))visual.ApplyCompanion(world.Session!=null?world.Session.SelectedCompanionId:originalId);
+        }
+        void OnDisable(){if(Application.isPlaying && visual!=null && visual.gameObject.activeInHierarchy)Restore();}
+        public void DrawControls()
+        {
+            if(!previewing || front==null || front.Page!=FrontPage.Title || world==null || world.StoryPlaying)return;
+            var rect=ControlsRect;
+            string name=CompanionChipCatalog.Find(DisplayedCharacterId)?.DisplayName??"";
+            UiTheme.Text(new Rect(rect.x+60,rect.y,rect.width-120,rect.height),name,FigmaGameSkin.Heading);
+            if(FigmaGameSkin.Pill(new Rect(rect.x,rect.y,48,40),"‹"))pendingDirection=-1;
+            if(FigmaGameSkin.Pill(new Rect(rect.xMax-48,rect.y,48,40),"›"))pendingDirection=1;
+        }
+    }
+}
